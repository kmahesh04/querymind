# Copy to .env and fill in. Never commit .env.

# One password per role. Give each person the password for their role.
# CEO: every table, full names and emails. Manager: operations, no customers or payments.
# BA: products, orders, shipments and reviews, no customers, payments or returns.
# The API refuses every data request until the passwords are set.
APP_PASSWORD_CEO=change-me-ceo-password
APP_PASSWORD_MANAGER=change-me-manager-password
APP_PASSWORD_BA=change-me-ba-password

# Text generation: Gemini is the default. Set to grok to make Grok the primary.
# The other provider is used only if the primary fails, and only if its key is set.
LLM_PROVIDER=gemini

# Gemini: text generation and the embedding model for example retrieval.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Grok (xAI): optional. Leave the key blank to turn it off.
GROK_API_KEY=
# Check the exact model name in the xAI Console.
GROK_MODEL=grok-4

# 1 = the model writes a sentence summary of each result (2 extra calls per question); 0 = template only
EXPLAIN_WITH_MODEL=1
# Where the Streamlit app finds the API
API_URL=http://localhost:8000
